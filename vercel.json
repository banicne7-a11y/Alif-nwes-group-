{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/google-news-sitemap.xml",
      "destination": "/api/sitemap?type=news"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/ads.txt",
      "destination": "/api/ads-txt"
    },
    {
      "source": "/",
      "destination": "/api/render?type=home"
    },
    {
      "source": "/usa",
      "destination": "/api/render?type=country&country=usa"
    },
    {
      "source": "/uk",
      "destination": "/api/render?type=country&country=uk"
    },
    {
      "source": "/canada",
      "destination": "/api/render?type=country&country=canada"
    },
    {
      "source": "/australia",
      "destination": "/api/render?type=country&country=australia"
    },
    {
      "source": "/usa/:slug",
      "destination": "/api/render?type=article&country=usa&slug=:slug"
    },
    {
      "source": "/uk/:slug",
      "destination": "/api/render?type=article&country=uk&slug=:slug"
    },
    {
      "source": "/canada/:slug",
      "destination": "/api/render?type=article&country=canada&slug=:slug"
    },
    {
      "source": "/australia/:slug",
      "destination": "/api/render?type=article&country=australia&slug=:slug"
    },
    {
      "source": "/news/:slug",
      "destination": "/api/render?type=article&slug=:slug"
    },
    {
      "source": "/page/:slug",
      "destination": "/api/render?type=page&slug=:slug"
    },
    {
      "source": "/tag/:path*",
      "destination": "/api/render?type=redirect"
    },
    {
      "source": "/product/:path*",
      "destination": "/api/render?type=redirect"
    },
    {
      "source": "/((?!api/|index\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
